{
  "name": "@ullrai/diplay-helper",
  "version": "0.1.0",
  "description": "Live-guided DiPlay Skill and read-only MCP",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "verify:source": "tsx scripts/verify-source.ts",
    "package:skill": "node scripts/package-skill.mjs",
    "registry:prepare": "node scripts/prepare-registry.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UllrAI/diplay-helper.git"
  },
  "keywords": [
    "agent-skills",
    "mcp",
    "diplay",
    "carplay"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/UllrAI/diplay-helper/issues"
  },
  "homepage": "https://github.com/UllrAI/diplay-helper#readme",
  "private": true,
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
